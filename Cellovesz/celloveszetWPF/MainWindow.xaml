<Window x:Class="celloveszetWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:celloveszetWPF"
        mc:Ignorable="d"
        Title="celloveszetWPF" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="dataGrid" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <Label Grid.Column="1" Content="Név:" HorizontalAlignment="Left" Margin="41,22,0,0" VerticalAlignment="Top"/>
        <Label Grid.Column="1" Content="Lövés1:" HorizontalAlignment="Left" Margin="41,63,0,0" VerticalAlignment="Top"/>
        <Label Grid.Column="1" Content="Lövés2:" HorizontalAlignment="Left" Margin="41,104,0,0" VerticalAlignment="Top"/>
        <Label Grid.Column="1" Content="Lövés3:" HorizontalAlignment="Left" Margin="41,147,0,0" VerticalAlignment="Top"/>
        <Label Grid.Column="1" Content="Lövés4:" HorizontalAlignment="Left" Margin="41,195,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="NevBox" Grid.Column="1" HorizontalAlignment="Left" Margin="102,26,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="Loves1Box" Grid.Column="1" HorizontalAlignment="Left" Margin="102,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="Loves2Box" Grid.Column="1" HorizontalAlignment="Left" Margin="102,108,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="Loves3Box" Grid.Column="1" HorizontalAlignment="Left" Margin="102,151,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="Loves4Box" Grid.Column="1" HorizontalAlignment="Left" Margin="102,199,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button Grid.Column="1" Content="Hozzáadás" HorizontalAlignment="Left" Margin="102,258,0,0" VerticalAlignment="Top" Width="78" Click="Hozzaadas"/>
        <Button Grid.Column="1" Content="Mentés" HorizontalAlignment="Left" Margin="102,301,0,0" VerticalAlignment="Top" Width="78" Click="Mentes"/>

    </Grid>
</Window>
